# Apify token used to scrape Instagram profiles and reels
APIFY_TOKEN=

# Supabase project used for email/password authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: SQLite database location (defaults to ./instafeed.db)
# INSTAFEED_DB_PATH=./instafeed.db

# Optional: background poll interval in ms (default 180000, minimum 10000, 0 disables)
# INSTAFEED_POLL_INTERVAL_MS=180000
